<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No app tracking -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No app-collected data in the inspected implementation -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason APIs and their actual uses -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- File metadata APIs -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: metadata inside the app container; 3B52.1: user-selected files -->
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>

		<!-- Disk-space APIs -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1: capacity checks before writes; 85F4.1: on-device storage display -->
				<string>E174.1</string>
				<string>85F4.1</string>
			</array>
		</dict>

		<!-- UserDefaults API -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: preferences accessible only to this app -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<!-- No tracking domains -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
</dict>
</plist>
